<!DOCTYPE html>
<!-- 💜 ESTE É O NOSSO BLOG!
     Esta página começa quase vazia. Vamos montar o blog aos pouquinhos,
     colando os pedaços que estão na pasta codigos/, na ordem das ETAPAS abaixo.
 -->

<!-- 🏠 <html> = começo da página. lang="pt-BR" = a página está em português. -->
<html lang="pt-BR">

<!-- ⚙️ <head> = configurações da página. Nada daqui aparece na tela.
     ⚠️ Não precisa mexer aqui: sem estas linhas o blog fica sem estilo. -->
<head>
    <!-- 🔤 Faz os acentos (á, ç, ã) e os emojis aparecerem certinho. -->
    <meta charset="UTF-8">

    <!-- 📱 Faz o site se ajustar ao tamanho da tela do celular. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- 🏷️ <title> = o nome que aparece na aba do navegador. ✏️ Troque! -->
    <title>Meu Blog</title>

    <!-- 🎨 Tailwind = uma ferramenta de estilos prontos. É ela que faz os class="..." funcionarem. -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- 🎨 Liga esta página ao nosso arquivo de estilos (css/style.css). -->
    <link rel="stylesheet" href="css/style.css">
</head>

<!-- 📄 <body> = o corpo da página. Tudo o que aparece na tela fica aqui dentro.
     bg-slate-50 = fundo cinza bem clarinho. text-slate-800 = texto cinza escuro. -->
<body class="bg-slate-50 text-slate-800">


    <!-- 🧭 ETAPA 1 — NAVBAR (o menu do topo)
         Escolha UMA opção em codigos/01-navbar/ e cole embaixo desta linha. -->

<!-- 🧭 <nav> = o menu do site. -->
<nav class="bg-white/95 backdrop-blur border-b border-slate-200 sticky top-0 z-50">

    <!-- 📦 <div> = uma caixa que agrupa coisas. -->
    <div class="max-w-6xl mx-auto px-5 sm:px-6 h-16 flex items-center justify-between">

        <!-- 🔗 <a> = um link. href="#inicio" leva ao topo da página.
             ✏️ Troque "MeuBlog." pelo nome do blog.
             🖼️ <img> = a logo, em assets/logo/logo.png. -->
        <a href="#inicio" class="flex items-center gap-2 text-xl font-black tracking-tight text-purple-700">
            <img src="assets/logo/logo.png" alt="Logo do blog" class="h-10 w-10 rounded-full object-cover">
            MeuBlog.
        </a>

        <!-- junta os três links — Início, Posts e Sobre — pra eles ficarem um do lado do outro . -->
        <div class="flex items-center gap-4 sm:gap-7 text-sm sm:text-base font-medium">
            <a href="#inicio" class="hover:text-purple-600 transition">Início</a>
            <a href="#posts" class="hover:text-purple-600 transition">Posts</a>
            <a href="#sobre" class="hover:text-purple-600 transition">Sobre</a>
        </div>
    </div>
</nav>


    <!-- 🌟 ETAPA 2 — HERO (a capa do blog, com o título grande)
         Escolha UMA opção em codigos/02-hero/ e cole embaixo desta linha. -->

<!-- 🌟 HERO 1 — "Minimalista": tudo centralizado, fundo clarinho.
     A hero é a "capa" do site: a primeira parte grande que a pessoa vê.
     📋 Como usar: copie tudo e cole no index.html, embaixo de "ETAPA 2". -->

<!-- 🌟 <header> = o cabeçalho, a capa da página.
     id="inicio" = o nome desta parte. É para cá que o link "Início" do menu leva. -->
<header id="inicio" class="bg-gradient-to-br from-purple-50 via-white to-pink-50">

   
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-20 sm:py-28 text-center">

        <!-- 🏷️ <span> = um pedacinho de texto. Aqui ele vira um selinho com cantos redondos.
              -->
        <span class="inline-block px-4 py-2 rounded-full bg-purple-100 text-purple-700 text-sm font-bold">
            ✨ Nosso primeiro blog
        </span>

        <!-- 📰 <h1> = o título mais importante da página, como a manchete de um jornal.
            -->
        <h1 class="max-w-4xl mx-auto mt-6 text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900">
            Criando, aprendendo e compartilhando ideias.
        </h1>

        <!--  <p> = um parágrafo, um texto comum.  -->
        <p class="max-w-2xl mx-auto mt-5 text-base sm:text-lg text-slate-600 leading-relaxed">
            Um espaço feito por nós para explorar tecnologia, criatividade e tudo aquilo que queremos compartilhar.
        </p>

        <!-- 🔘 <a> = um link com cara de botão (fundo roxo e cantos redondos).
              -->
        <a href="#posts" class="inline-block mt-8 bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-xl font-bold transition">
            Conhecer os posts
        </a>

        <!-- 🖼️ <img> = uma IMAGEM. Ela puxa a foto que está em assets/hero/hero.png.
              -->
        <img src="assets/hero/hero.png" alt="Imagem de capa do blog" class="max-w-3xl w-full mx-auto mt-12 rounded-3xl shadow-xl">
    </div>
</header>


    <!-- 🃏 ETAPA 3 — CARDS (os posts do blog)
         Copie o código de codigos/03-cards/cards.html e cole embaixo desta linha.
         ✏️ Depois, complete os 6 cards com os posts do seu grupo! -->
<!-- 🃏 SEÇÃO DE POSTS — 6 CARDS PARA COMPLETAR -->
<section id="posts" class="max-w-6xl mx-auto px-5 sm:px-6 py-16 sm:py-20">

    <div class="mb-10">
        <p class="text-purple-600 font-bold">PUBLICAÇÕES</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-black text-slate-900">
            O que estamos compartilhando
        </h2>
        <p class="mt-3 text-slate-600">
            ✏️ Complete os 6 cards abaixo com os posts do seu grupo!
        </p>
    </div>

    <!-- 📦 Grid: 1 card por linha no celular, 2 no tablet, 3 no desktop -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- 🃏 CARD 1 — ✏️ Troque os textos e salve a imagem em assets/cards/card1.png -->
        <article class="group bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition">
            <img src="assets/cards/card1.png" alt="Imagem do post 1" class="h-32 w-full object-cover bg-slate-200">
            <div class="p-6">
                <span class="text-purple-600 text-sm font-bold">PONHA A CATEGORIA AQUI</span>
                <h3 class="mt-2 text-xl font-black">Ponha o título aqui</h3>
                <p class="mt-3 text-slate-600 leading-relaxed">Ponha aqui a descrição do seu post.</p>
                <button class="botao-post mt-6 text-purple-700 font-bold hover:underline">Ler post →</button>
            </div>
        </article>

        <!-- 🃏 CARD 2 — imagem: assets/cards/card2.png -->
        <article class="group bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition">
            <img src="assets/cards/card2.png" alt="Imagem do post 2" class="h-32 w-full object-cover bg-slate-200">
            <div class="p-6">
                <span class="text-pink-600 text-sm font-bold">PONHA A CATEGORIA AQUI</span>
                <h3 class="mt-2 text-xl font-black">Ponha o título aqui</h3>
                <p class="mt-3 text-slate-600 leading-relaxed">Ponha aqui a descrição do seu post.</p>
                <button class="botao-post mt-6 text-pink-700 font-bold hover:underline">Ler post →</button>
            </div>
        </article>

        <!-- 🃏 CARD 3 — imagem: assets/cards/card3.png -->
        <article class="group bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition">
            <img src="assets/cards/card3.png" alt="Imagem do post 3" class="h-32 w-full object-cover bg-slate-200">
            <div class="p-6">
                <span class="text-blue-600 text-sm font-bold">PONHA A CATEGORIA AQUI</span>
                <h3 class="mt-2 text-xl font-black">Ponha o título aqui</h3>
                <p class="mt-3 text-slate-600 leading-relaxed">Ponha aqui a descrição do seu post.</p>
                <button class="botao-post mt-6 text-blue-700 font-bold hover:underline">Ler post →</button>
            </div>
        </article>

        <!-- 🃏 CARD 4 — imagem: assets/cards/card4.png -->
        <article class="group bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition">
            <img src="assets/cards/card4.png" alt="Imagem do post 4" class="h-32 w-full object-cover bg-slate-200">
            <div class="p-6">
                <span class="text-emerald-600 text-sm font-bold">PONHA A CATEGORIA AQUI</span>
                <h3 class="mt-2 text-xl font-black">Ponha o título aqui</h3>
                <p class="mt-3 text-slate-600 leading-relaxed">Ponha aqui a descrição do seu post.</p>
                <button class="botao-post mt-6 text-emerald-700 font-bold hover:underline">Ler post →</button>
            </div>
        </article>

        <!-- 🃏 CARD 5 — imagem: assets/cards/card5.png -->
        <article class="group bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition">
            <img src="assets/cards/card5.png" alt="Imagem do post 5" class="h-32 w-full object-cover bg-slate-200">
            <div class="p-6">
                <span class="text-orange-600 text-sm font-bold">PONHA A CATEGORIA AQUI</span>
                <h3 class="mt-2 text-xl font-black">Ponha o título aqui</h3>
                <p class="mt-3 text-slate-600 leading-relaxed">Ponha aqui a descrição do seu post.</p>
                <button class="botao-post mt-6 text-orange-700 font-bold hover:underline">Ler post →</button>
            </div>
        </article>

        <!-- 🃏 CARD 6 — imagem: assets/cards/card6.png -->
        <article class="group bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition">
            <img src="assets/cards/card6.png" alt="Imagem do post 6" class="h-32 w-full object-cover bg-slate-200">
            <div class="p-6">
                <span class="text-purple-600 text-sm font-bold">PONHA A CATEGORIA AQUI</span>
                <h3 class="mt-2 text-xl font-black">Ponha o título aqui</h3>
                <p class="mt-3 text-slate-600 leading-relaxed">Ponha aqui a descrição do seu post.</p>
                <button class="botao-post mt-6 text-purple-700 font-bold hover:underline">Ler post →</button>
            </div>
        </article>

    </div>
</section>


    <!-- 👣 ETAPA 4 — RODAPÉ (a parte de baixo da página)
         Escolha UMA opção em codigos/04-rodape/ e cole embaixo desta linha. -->

<!-- 👣 RODAPÉ 1 — "Simples": fundo escuro, tudo centralizado.
     O rodapé é a última parte do site, como a assinatura no fim de uma carta.
     📋 Como usar: copie tudo e cole no index.html, embaixo de "ETAPA 4". -->

<!-- 👣 <footer> = o rodapé.
     id="sobre" = o nome desta parte. É para cá que o link "Sobre" do menu leva. -->
<footer id="sobre" class="bg-slate-950 text-white">

    <!-- 📦 <div> = uma caixa. text-center = centraliza tudo. -->
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-10 text-center">

        <!-- 📰 <h2> = um subtítulo, aqui com o nome do blog. ✏️ Troque pelo nome de vocês! -->
        <h2 class="text-2xl font-black">MeuBlog.</h2>

        <!-- 📝 <p> = um parágrafo. ✏️ Escreva uma mensagem de vocês! -->
        <p class="mt-3 text-slate-400">Criado com ideias, código e muita criatividade 💜</p>

        <!-- 📝 Texto pequeno (text-xs) com o ano. O © quer dizer "fomos nós que fizemos". -->
        <p class="mt-6 text-xs text-slate-600">© 2026 • Nossa primeira experiência web</p>
    </div>
</footer>


    <!-- ⚡ ETAPA 5 — JAVASCRIPT
         Esta linha já está pronta! Ela liga a página ao arquivo js/main.js.
         É ele que faz os botões dos cards mostrarem uma mensagem quando você clica.
         ⚠️ Deixe sempre aqui no final, depois de todas as etapas. -->
    <script src="js/main.js"></script>

</body>
</html>